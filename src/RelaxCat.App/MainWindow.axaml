<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:RelaxCat.App.Models"
        xmlns:views="using:RelaxCat.App.Views"
        x:Class="RelaxCat.App.MainWindow" x:DataType="models:WorkspaceModel" x:CompileBindings="True"
        Icon="/Assets/relaxcat.ico" Title="RelaxCat" Width="1280" Height="850" MinWidth="1000" MinHeight="680"
        KeyDown="WindowKeyDown">
  <Grid RowDefinitions="68,*,Auto">
    <!-- Desktop shell. Detailed configuration lives on SettingsView. -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" IsEnabled="{Binding !PreviewOpen}">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,0">
        <Image Source="/Assets/relaxcat.png" Width="34" Height="34" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
          <TextBlock Text="RelaxCat" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding Text[Tagline]}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="ThemeButton" Classes="quiet" Content="{Binding Text[Theme]}" Click="ToggleThemeClicked" />
          <Border Width="1" Background="{DynamicResource LineBrush}" Margin="4,6" />
          <Button x:Name="ImportButton" Content="{Binding Text[Import]}" Click="ImportClicked" IsEnabled="{Binding IsIdle}" />
          <Button x:Name="ExportButton" Classes="primary" Content="{Binding Text[Export]}" Click="ExportClicked" IsEnabled="{Binding CanExport}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="174,*" IsEnabled="{Binding !PreviewOpen}">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="10,22" Spacing="6">
          <Button x:Name="HomeButton" Classes="nav" Classes.active="{Binding HomeOpen}" Content="{Binding Text[Workspace]}" Click="HomeClicked" />
          <Button x:Name="SettingsButton" Classes="nav" Classes.active="{Binding SettingsOpen}" Content="{Binding Text[Settings]}" Click="SettingsClicked" />
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,20,6,10" />
          <TextBlock Classes="muted" Text="{Binding CaptureStatus}" TextWrapping="Wrap" Margin="10,0" />
          <Button x:Name="CaptureSettingsButton" Classes="nav" Content="{Binding Text[CaptureTab]}" Click="CaptureSettingsClicked" />
        </StackPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid x:Name="HomePage" RowDefinitions="Auto,Auto,*" Margin="26,24,18,12" IsVisible="{Binding HomeOpen}">
          <Grid ColumnDefinitions="*,Auto" Margin="8,0,12,20">
            <StackPanel Spacing="7">
              <TextBlock Classes="heading" Text="{Binding Text[Workspace]}" />
              <TextBlock Classes="muted" Text="{Binding Text[GalleryHint]}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="12,7" VerticalAlignment="Center">
              <TextBlock x:Name="SummaryLabel" Text="{Binding Summary}" FontSize="12" />
            </Border>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16,10" Margin="8,0,12,16">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" IsEnabled="{Binding IsIdle}">
              <TextBlock Text="{Binding Text[DesignScale]}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBox x:Name="QuickScale" Grid.Column="1" Width="80" Text="{Binding Settings.DesignScale, Mode=TwoWay}" />
              <CheckBox Grid.Column="2" Content="{Binding Text[Compact]}" IsChecked="{Binding Settings.Compact, Mode=TwoWay}" Margin="24,0,0,0" />
              <Button Grid.Column="4" Classes="quiet" Content="{Binding Text[MoreSettings]}" Click="SettingsClicked" />
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Gallery" ItemsSource="{Binding Images}" IsEnabled="{Binding IsIdle}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ImageItem">
                  <Border Classes="card" Width="272" Margin="8,0,8,18" ClipToBounds="True">
                    <Grid RowDefinitions="170,Auto,Auto,Auto">
                      <Button Classes="quiet" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Click="ImagePreviewClicked" ToolTip.Tip="{Binding Text[Preview]}">
                        <Border Background="{DynamicResource WellBrush}" Padding="12">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" Opacity="{Binding ThumbnailOpacity}" />
                        </Border>
                      </Button>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" Margin="14,13,14,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Image.Path}" />
                      <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Details}" Margin="14,5,14,10" />
                      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,4">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <CheckBox Content="{Binding Text[Include]}" IsChecked="{Binding IncludeInExport, Mode=TwoWay}" FontSize="12" />
                          <Button Grid.Column="1" Classes="quiet" Padding="8,8" Content="{Binding Text[Copy]}" FontSize="12" Click="CopyImageClicked" ToolTip.Tip="{Binding Text[CopyHint]}" />
                          <Button Grid.Column="2" Classes="quiet" Padding="8,8" Content="{Binding Text[Remove]}" FontSize="12" Click="RemoveImageClicked" ToolTip.Tip="{Binding Text[RemoveHint]}" />
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="2" IsVisible="{Binding NoImages}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="20">
            <Border Background="{DynamicResource AccentSoftBrush}" Width="76" Height="76" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,8">
              <Path Data="M 4,4 L 36,4 L 36,32 L 4,32 Z M 4,26 L 15,15 L 23,23 L 29,17 L 36,24 M 26,10 L 29,10"
                    Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Width="40" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Text[EmptyTitle]}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Text[EmptyHint]}" TextWrapping="Wrap" MaxWidth="450" TextAlignment="Center" />
            <Button Classes="primary" Content="{Binding Text[Import]}" Click="ImportClicked" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Center" Margin="0,8" />
            <TextBlock Classes="muted" Text="{Binding Text[EmptyFormats]}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
        <views:SettingsView x:Name="SettingsPage" IsVisible="{Binding SettingsOpen}" ApplyCaptureRequested="ApplyCaptureRequested" StopCaptureRequested="StopCaptureRequested" />
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusLabel" Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="58" VerticalAlignment="Center" FontSize="12" />
        <Button Grid.Column="1" Content="{Binding Text[Cancel]}" Click="CancelClicked" IsVisible="{Binding IsBusy}" Padding="12,5" Margin="12,0,0,0" />
        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="3" Margin="0,7,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <!-- In-window lightbox inherits theme/language and leaves the gallery in place. -->
    <Border x:Name="PreviewOverlay" Grid.RowSpan="3" ZIndex="10" Background="#B3141620" IsVisible="{Binding PreviewOpen}" PointerPressed="PreviewBackdropPressed">
      <Border Classes="lightbox" Classes.open="{Binding PreviewOpen}" Margin="42" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" BoxShadow="0 18 70 0 #66000000" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding PreviewItem.Name}" TextTrimming="CharacterEllipsis" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding PreviewItem.Details}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="{Binding Text[Include]}" IsChecked="{Binding PreviewItem.IncludeInExport, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" Margin="16,0" />
              <Button x:Name="ClosePreviewButton" Grid.Column="2" Classes="quiet" Content="✕" FontSize="18" ToolTip.Tip="{Binding Text[Close]}" Click="ClosePreviewClicked" />
            </Grid>
          </Border>
          <Border x:Name="PreviewViewport" Grid.Row="1" Background="{DynamicResource WellBrush}" Padding="24">
            <Grid x:Name="PreviewCanvas">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                  <LayoutTransformControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding PreviewZoom}" ScaleY="{Binding PreviewZoom}" />
                  </LayoutTransformControl.LayoutTransform>
                  <Image x:Name="LargePreview" Source="{Binding PreviewBitmap}" Stretch="Uniform"
                         MaxWidth="{Binding #PreviewCanvas.Bounds.Width}" MaxHeight="{Binding #PreviewCanvas.Bounds.Height}" />
                </LayoutTransformControl>
              </ScrollViewer>
              <TextBlock Text="{Binding Text[Loading]}" IsVisible="{Binding PreviewLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
              <Button x:Name="PreviousPreviewButton" Content="{Binding Text[Previous]}" Click="PreviousPreviewClicked" IsEnabled="{Binding HasPrevious}" />
              <Button x:Name="NextPreviewButton" Grid.Column="1" Content="{Binding Text[Next]}" Click="NextPreviewClicked" IsEnabled="{Binding HasNext}" Margin="8,0" />
              <Slider x:Name="PreviewZoomSlider" Grid.Column="3" Minimum="0.5" Maximum="3" Value="{Binding PreviewZoom, Mode=TwoWay}" Width="160" Margin="16,0" ToolTip.Tip="{Binding Text[Preview]}" />
              <Button Grid.Column="4" Classes="quiet" Content="{Binding Text[Fit]}" Click="FitPreviewClicked" />
              <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Classes="muted" Text="{Binding Text[PreviewHint]}" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
