<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:RelaxCat.App.Models"
             x:Class="RelaxCat.App.Views.SettingsView" x:DataType="models:WorkspaceModel" x:CompileBindings="True">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,16">
    <StackPanel Spacing="8" Margin="0,0,0,4">
      <TextBlock Classes="heading" Text="{Binding Text[Settings]}" />
      <TextBlock Classes="muted" Text="{Binding Text[SettingsHint]}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Pages use two balanced columns and centre themselves on wide screens instead of
         leaving a fixed 680px block stuck to the left edge. -->
    <TabControl Grid.Row="1" FontSize="13" TabStripPlacement="Left" Classes="settings">
      <TabItem FontSize="13" Header="{Binding Text[SizingTab]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <Grid MaxWidth="1040" HorizontalAlignment="Stretch" ColumnDefinitions="*,*" ColumnSpacing="40" Margin="26,12,16,24" IsEnabled="{Binding IsIdle}">
            <StackPanel Spacing="14">
              <TextBlock Classes="muted" Text="{Binding Text[SizeHint]}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="14">
                <StackPanel Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[DesignWidth]}" />
                  <TextBox Text="{Binding Settings.DesignWidth, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[DesignHeight]}" />
                  <TextBox Text="{Binding Settings.DesignHeight, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[DesignScale]}" />
                  <TextBox Text="{Binding Settings.DesignScale, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[MaxEnlargement]}" />
                  <TextBox Text="{Binding Settings.MaximumEnlargement, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Classes="section" Text="{Binding Text[Rules]}" Margin="0" />
              <TextBlock Classes="muted" Text="{Binding Text[RulesHint]}" TextWrapping="Wrap" />
              <TextBox x:Name="RulesEditor" Text="{Binding Settings.Rules, Mode=TwoWay}" PlaceholderText="{Binding Text[RulesPlaceholder]}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="300" FontFamily="Cascadia Code, Consolas" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem FontSize="13" Header="{Binding Text[ExcelTab]}">
        <ScrollViewer x:Name="ExcelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <Grid MaxWidth="1040" HorizontalAlignment="Stretch" ColumnDefinitions="*,*" ColumnSpacing="40" Margin="26,12,16,24" IsEnabled="{Binding IsIdle}">
            <StackPanel Spacing="14">
              <TextBlock Classes="section" Text="{Binding Text[CellSection]}" Margin="0" />
              <CheckBox Content="{Binding Text[Compact]}" IsChecked="{Binding Settings.Compact, Mode=TwoWay}" />
              <StackPanel Spacing="5">
                <TextBlock Classes="field" Text="{Binding Text[HorizontalGap]}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding Settings.HorizontalGap, Mode=TwoWay}" />
                  <ComboBox x:Name="HorizontalGapUnitSelector" Grid.Column="1" ItemsSource="{Binding GapUnitChoices}" SelectedIndex="{Binding Settings.HorizontalGapUnitIndex, Mode=TwoWay}" MinWidth="96">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:LocalizedOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Classes="field" Text="{Binding Text[VerticalGap]}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding Settings.VerticalGap, Mode=TwoWay}" />
                  <ComboBox x:Name="VerticalGapUnitSelector" Grid.Column="1" ItemsSource="{Binding GapUnitChoices}" SelectedIndex="{Binding Settings.VerticalGapUnitIndex, Mode=TwoWay}" MinWidth="96">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:LocalizedOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <StackPanel Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[RowHeight]}" />
                  <TextBox Text="{Binding Settings.RowHeight, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[ColumnWidth]}" />
                  <TextBox Text="{Binding Settings.ColumnWidth, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" Text="{Binding Text[CellGapHint]}" TextWrapping="Wrap" />
              <TextBlock Classes="section" Text="{Binding Text[StartCellSection]}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <StackPanel Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[StartRow]}" />
                  <TextBox x:Name="StartRowInput" Text="{Binding Settings.StartRow, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Classes="field" Text="{Binding Text[StartColumn]}" />
                  <TextBox x:Name="StartColumnInput" Text="{Binding Settings.StartColumn, Mode=TwoWay}" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="muted" Text="{Binding Text[StartCellHint]}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="14">
              <TextBlock Classes="section" Text="{Binding Text[WorksheetSection]}" Margin="0" />
              <CheckBox x:Name="ShowGridlinesOption" Content="{Binding Text[ShowGridlines]}" IsChecked="{Binding Settings.ShowGridlines, Mode=TwoWay}" />
              <CheckBox x:Name="SelectAllPicturesOption" Content="{Binding Text[SelectAllPictures]}" IsChecked="{Binding Settings.SelectAllPicturesAfterExport, Mode=TwoWay}" />
              <TextBlock Classes="muted" Text="{Binding Text[SelectPicturesHint]}" TextWrapping="Wrap" />
              <TextBlock Classes="section" Text="{Binding Text[Template]}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding Settings.TemplatePath, Mode=TwoWay}" />
                <Button Grid.Column="1" Content="{Binding Text[Browse]}" Click="BrowseTemplateClicked" />
              </Grid>
              <TextBlock Classes="muted" Text="{Binding Text[TemplateHint]}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem FontSize="13" Header="{Binding Text[AppearanceTab]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <Grid MaxWidth="1040" HorizontalAlignment="Stretch" ColumnDefinitions="*,*" ColumnSpacing="40" Margin="26,12,16,24">
            <StackPanel Spacing="14">
              <TextBlock Classes="section" Text="{Binding Text[Appearance]}" Margin="0" />
              <ComboBox x:Name="ThemeSelector" ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:LocalizedOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="14">
              <TextBlock Classes="section" Text="{Binding Text[Language]}" Margin="0" />
              <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding Languages}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="CaptureTab" FontSize="13" Header="{Binding Text[CaptureTab]}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
          <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Margin="26,12,16,20" Spacing="12">
            <TextBlock Text="{Binding CaptureStatus}" FontWeight="SemiBold" />
            <StackPanel Spacing="10" IsEnabled="{Binding CanApplyCapture}">
              <StackPanel Spacing="5">
                <TextBlock Classes="field" Text="{Binding Text[CaptureProvider]}" />
                <ComboBox x:Name="CaptureProviderSelector" ItemsSource="{Binding CaptureProviderChoices}" SelectedIndex="{Binding Capture.ProviderIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="models:LocalizedOption"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Classes="field" Text="{Binding Text[CaptureFolder]}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox x:Name="CaptureFolderInput" Text="{Binding Capture.Folder, Mode=TwoWay}" MinWidth="340" />
                  <Button Grid.Column="1" Content="{Binding Text[Browse]}" Click="BrowseCaptureFolderClicked" />
                </Grid>
              </StackPanel>
              <TextBlock Classes="muted" Text="{Binding Text[CaptureFolderHint]}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding Text[CaptureGreenshotHint]}" TextWrapping="Wrap" IsVisible="{Binding Capture.IsGreenshot}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <Button x:Name="ApplyCaptureButton" Classes="primary" Content="{Binding Text[CaptureApply]}" Click="ApplyCaptureClicked" IsEnabled="{Binding CanApplyCapture}" />
              <Button x:Name="StopCaptureButton" Content="{Binding Text[CaptureStop]}" Click="StopCaptureClicked" IsEnabled="{Binding CanStopCapture}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" MaxWidth="1040" HorizontalAlignment="Stretch" Margin="26,12,16,0">
      <TextBlock Classes="muted" Text="{Binding Text[SessionHint]}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</UserControl>
