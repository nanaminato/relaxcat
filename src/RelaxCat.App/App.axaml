<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelaxCat.App.DesktopApp" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush">#1E1F22</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBrush">#2B2D30</SolidColorBrush>
          <SolidColorBrush x:Key="RaisedBrush">#323438</SolidColorBrush>
          <SolidColorBrush x:Key="WellBrush">#25262A</SolidColorBrush>
          <SolidColorBrush x:Key="LineBrush">#414349</SolidColorBrush>
          <SolidColorBrush x:Key="InkBrush">#E7E9EF</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#A1A5B1</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoftBrush">#253A59</SolidColorBrush>
          <SolidColorBrush x:Key="AccentInkBrush">#9CBCFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentHoverBrush">#6C9BFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentPressedBrush">#457BEA</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBrush">#3A3D43</SolidColorBrush>
          <SolidColorBrush x:Key="ControlHoverBrush">#44474E</SolidColorBrush>
          <SolidColorBrush x:Key="ControlPressedBrush">#4C5058</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorderBrush">#4C5058</SolidColorBrush>
          <SolidColorBrush x:Key="DangerBrush">#E4837B</SolidColorBrush>
          <SolidColorBrush x:Key="DangerSoftBrush">#3F2A2A</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayBrush">#B3141620</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush">#F3F4F7</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="RaisedBrush">#F8F9FC</SolidColorBrush>
          <SolidColorBrush x:Key="WellBrush">#EDEFF4</SolidColorBrush>
          <SolidColorBrush x:Key="LineBrush">#DDE1E9</SolidColorBrush>
          <SolidColorBrush x:Key="InkBrush">#222733</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#646C7D</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoftBrush">#E5EEFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentInkBrush">#2F5FC4</SolidColorBrush>
          <SolidColorBrush x:Key="AccentHoverBrush">#3F79E8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentPressedBrush">#2A64D4</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ControlHoverBrush">#F2F5FB</SolidColorBrush>
          <SolidColorBrush x:Key="ControlPressedBrush">#E7ECF5</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorderBrush">#D5DAE4</SolidColorBrush>
          <SolidColorBrush x:Key="DangerBrush">#C0392B</SolidColorBrush>
          <SolidColorBrush x:Key="DangerSoftBrush">#FBEAE7</SolidColorBrush>
          <SolidColorBrush x:Key="OverlayBrush">#B3141620</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="AccentBrush">#568AF2</SolidColorBrush>
      <Color x:Key="SystemAccentColor">#3574F0</Color>

      <!-- Linear glyph set. Every path is authored in a 16x16 box and drawn stroke-only,
           so the same geometry works in both themes and inherits the button foreground. -->
      <StreamGeometry x:Key="IconTheme">M8,1.7 L8,3.5 M8,12.5 L8,14.3 M1.7,8 L3.5,8 M12.5,8 L14.3,8 M3.6,3.6 L4.9,4.9 M11.1,11.1 L12.4,12.4 M12.4,3.6 L11.1,4.9 M4.9,11.1 L3.6,12.4 M8,5.1 A2.9,2.9 0 1,0 8,10.9 A2.9,2.9 0 1,0 8,5.1</StreamGeometry>
      <StreamGeometry x:Key="IconImport">M1.9,10.4 L1.9,13.5 L14.1,13.5 L14.1,10.4 M8,2 L8,9.8 M4.8,6.6 L8,9.8 L11.2,6.6</StreamGeometry>
      <StreamGeometry x:Key="IconExport">M1.9,10.4 L1.9,13.5 L14.1,13.5 L14.1,10.4 M8,10.2 L8,2.4 M4.8,5.6 L8,2.4 L11.2,5.6</StreamGeometry>
      <StreamGeometry x:Key="IconPicture">M2.4,3.4 L13.6,3.4 L13.6,12.6 L2.4,12.6 Z M2.4,10.3 L5.9,6.8 L8.9,9.8 L10.9,7.8 L13.6,10.6 M9.9,5.7 A0.95,0.95 0 1,0 11.8,5.7 A0.95,0.95 0 1,0 9.9,5.7</StreamGeometry>
      <StreamGeometry x:Key="IconSliders">M1.9,5.5 L14.1,5.5 M1.9,10.5 L14.1,10.5 M4.5,5.5 A1.5,1.5 0 1,0 7.5,5.5 A1.5,1.5 0 1,0 4.5,5.5 M9.1,10.5 A1.5,1.5 0 1,0 12.1,10.5 A1.5,1.5 0 1,0 9.1,10.5</StreamGeometry>
      <StreamGeometry x:Key="IconCapture">M1.9,5.2 L4.9,5.2 L6.1,3.1 L9.9,3.1 L11.1,5.2 L14.1,5.2 L14.1,13.1 L1.9,13.1 Z M6.7,9.1 A1.9,1.9 0 1,0 10.5,9.1 A1.9,1.9 0 1,0 6.7,9.1</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M2.2,4.4 L13.8,4.4 M6.2,4.4 L6.2,2.2 L9.8,2.2 L9.8,4.4 M3.9,4.4 L4.8,13.8 L11.2,13.8 L12.1,4.4 M6.7,7.2 L7,11.2 M9.3,7.2 L9,11.2</StreamGeometry>
      <StreamGeometry x:Key="IconCopy">M6.4,6.4 L14,6.4 L14,14 L6.4,14 Z M9.6,6.4 L9.6,2 L2,2 L2,9.6 L6.4,9.6</StreamGeometry>
      <StreamGeometry x:Key="IconRemove">M4.4,4.4 L11.6,11.6 M11.6,4.4 L4.4,11.6</StreamGeometry>
      <StreamGeometry x:Key="IconSort">M4.2,1.9 L4.2,13.4 M1.9,11.1 L4.2,13.4 L6.5,11.1 M8.8,4.2 L14.1,4.2 M8.8,8 L12.4,8 M8.8,11.8 L10.9,11.8</StreamGeometry>
      <StreamGeometry x:Key="IconChevronLeft">M9.8,2.6 L5.2,8 L9.8,13.4</StreamGeometry>
      <StreamGeometry x:Key="IconChevronRight">M6.2,2.6 L10.8,8 L6.2,13.4</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Yu Gothic UI" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.field">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <!-- Buttons: every state is theme-driven so secondary actions never fall back to a platform colour. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>
    <!-- Disabled buttons keep their shape but lose emphasis instead of turning into a solid grey chip. -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
    </Style>

    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Text actions keep a flat surface when disabled; a filled chip would read as a real button. -->
    <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Destructive but low-emphasis: muted until hovered. -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Glyphs. Stroke is chosen by the surrounding surface instead of a template binding,
         so every icon state is explicit and works inside data templates too. -->
    <Style Selector="Path.glyph">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.glyph.small">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Path.glyph.tiny">
      <Setter Property="Width" Value="11" />
      <Setter Property="Height" Value="11" />
      <Setter Property="StrokeThickness" Value="1.7" />
    </Style>
    <Style Selector="Button Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button.primary Path.glyph">
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="Button.quiet Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.quiet:pointerover Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button.nav Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button.nav.active Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource AccentInkBrush}" />
    </Style>
    <Style Selector="Button.danger Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button:disabled Path.glyph">
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 3 12 0 #12000000" />
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="TabControl.settings">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,12,0,0" />
    </Style>
    <!-- Only the page body becomes a surface; the strip stays on the page background so the
         selected-tab block is never clipped by a card edge. -->
    <Style Selector="TabControl.settings /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- The card hugs short pages; a tall page is still capped to the pane and scrolls inside it. -->
    <Style Selector="TabControl.settings ScrollViewer">
      <Setter Property="MaxHeight" Value="{Binding $parent[TabControl].Bounds.Height}" />
    </Style>
    <Style Selector="TabControl.settings TabItem">
      <Setter Property="MinWidth" Value="142" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2,8,2" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="TabControl.settings TabItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,16,0,2" />
    </Style>
    <Style Selector="TabControl.settings TextBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="TabControl.settings ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.lightbox.open">
      <Style.Animations>
        <Animation Duration="0:0:0.16" FillMode="Forward">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Application.Styles>
</Application>
